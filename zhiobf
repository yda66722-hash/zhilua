--- 3. 按钮交互 ---
RunBtn.MouseButton1Click:Connect(function()
    local code = Input.Text
    if code == "" or #code < 3 then
        RunBtn.Text = "代码太短！"
        wait(1)
        RunBtn.Text = "开始超强混淆"
        return
    end

    RunBtn.Text = "混淆中..."
    wait(0.5)

    local success, result = pcall(function()
        return Obfuscate(code)
    end)

    if success then
        -- 手机端最重要的功能：自动复制
        if setclipboard then
            setclipboard(result)
            RunBtn.Text = "已完成并复制！"
        else
            Input.Text = result
            RunBtn.Text = "复制失败，请手动选择文字"
        end
    else
        RunBtn.Text = "混淆出错！"
    end

    wait(2)
    RunBtn.Text = "开始超强混淆"
end)